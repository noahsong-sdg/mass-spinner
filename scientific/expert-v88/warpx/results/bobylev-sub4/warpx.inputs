max_step = 100
geometry.dims = RZ
geometry.prob_lo = 0 0
geometry.prob_hi = 0.06 0.04
amr.n_cell = 8 8
amr.max_level = 0
amr.blocking_factor = 1
amr.max_grid_size = 64
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = None Periodic
boundary.particle_hi = Reflecting Periodic
boundary.reflect_all_velocities = 0
algo.maxwell_solver = none
warpx.do_electrostatic = none
warpx.n_rz_azimuthal_modes = 1
warpx.const_dt = 9.9999999999999995e-08
warpx.verbose = 0
warpx.use_filter = 0
warpx.random_seed = 101
warpx.serialize_initial_conditions = 1
algo.particle_shape = 1
algo.particle_pusher = boris
particles.species_names = ionA ionB
particles.E_ext_particle_init_style = parse_e_ext_particle_function
particles.B_ext_particle_init_style = parse_b_ext_particle_function
particles.Ex_external_particle_function(x,y,z,t) = 1000.0*x
particles.Ey_external_particle_function(x,y,z,t) = 1000.0*y
particles.Ez_external_particle_function(x,y,z,t) = 0
particles.Bx_external_particle_function(x,y,z,t) = 0
particles.By_external_particle_function(x,y,z,t) = 0
particles.Bz_external_particle_function(x,y,z,t) = 0.1
ionA.charge = 1.6021766339999999e-19
ionA.mass = 6.6421562664000002e-26
ionA.injection_style = none
ionA.do_not_deposit = 1
ionA.do_not_gather = 0
ionA.do_not_push = 0
ionA.initialize_self_fields = 0
ionB.charge = 1.6021766339999999e-19
ionB.mass = 1.394852815944e-25
ionB.injection_style = none
ionB.do_not_deposit = 1
ionB.do_not_gather = 0
ionB.do_not_push = 0
ionB.initialize_self_fields = 0
collisions.collision_names = cross selfA selfB
collisions.correct_energy_momentum = 0
cross.type = pairwisecoulomb
cross.species = ionA ionB
cross.CoulombLog = 12
cross.cumulative_scattering_angle_model = BOBYLEV
cross.ndt_subcycle = 4
selfA.type = pairwisecoulomb
selfA.species = ionA ionA
selfA.CoulombLog = 12
selfA.cumulative_scattering_angle_model = BOBYLEV
selfA.ndt_subcycle = 4
selfB.type = pairwisecoulomb
selfB.species = ionB ionB
selfB.CoulombLog = 12
selfB.cumulative_scattering_angle_model = BOBYLEV
selfB.ndt_subcycle = 4
