{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "scripts/release-manifest.ts",
    "scripts/check-dependencies.ts",
    "scripts/check-gltf.ts",
    "scripts/export-thermal-toolchain.ts",
    "scripts/gltf-validator.d.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "tests/release-manifest.test.ts",
    "tests/dependency-review.test.ts",
    "tests/scenario-schema.test.ts",
    "tests/worker-client.test.ts",
    "scripts/build.mjs",
    "scripts/check-site.mjs",
    "scripts/guide-diagrams.mjs",
    "scripts/understanding-page.mjs",
    "scripts/qualification-page.mjs",
    "scripts/equilibrium-page.mjs",
    "scripts/release-links.mjs",
    "scripts/equilibrium-identity-plugin.mjs",
    "scripts/worker-identity-plugin.mjs",
    "vite.config.mjs",
    "scripts/qualify-gltf.ts"
  ]
}
