{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "public/engine"
  },
  "include": ["src/**/*.ts"]
}
