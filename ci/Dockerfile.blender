FROM node:26.13.1-bookworm@sha256:b7087bc4d973034b30854b378ba107f9fab622b47514cb7e2592e41b8bab8d49
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates curl xz-utils libx11-6 libxi6 libxrender1 libxfixes3 libxxf86vm1 libxkbcommon0 libegl1 libgl1 libsm6 libice6 libdbus-1-3 && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 https://download.blender.org/release/Blender5.2/blender-5.2.4-linux-x64.tar.xz -o /tmp/blender.tar.xz \
 && echo '2fd14c50987426897ba60237ee996edf2b4151f4b1a72a460ca20be58c1d2d86  /tmp/blender.tar.xz' | sha256sum --check - \
 && mkdir /opt/blender && tar -xJf /tmp/blender.tar.xz --strip-components=1 -C /opt/blender && rm /tmp/blender.tar.xz
ENV MASS_SPINNER_BLENDER=/opt/blender/blender
