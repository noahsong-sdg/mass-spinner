
> typecheck
> tsc --noEmit --checkers 1 && tsc --noEmit --checkers 1 -p tsconfig.contracts.json


> typecheck:infrastructure
> tsc --noEmit --checkers 1 -p tsconfig.infrastructure.json


> typecheck:boundaries
> tsc --noEmit --checkers 1 -p tsconfig.boundaries.json


> typecheck:tests
> tsc --noEmit --checkers 1 -p tsconfig.tests.json


> lint
> eslint src --max-warnings 0


> build
> tsx scripts/qualify-gltf.ts && node scripts/build.mjs

