{
  "name": "mass-spinner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check:assets": "python3 blender/check_assets.py",
    "check:site": "node scripts/check-site.mjs",
    "render:host": ".tools/blender36/Blender/Blender.app/Contents/MacOS/Blender --background --gpu-backend opengl --factory-startup --python-exit-code 1 --python blender/build_separator.py"
  },
  "devDependencies": {
    "jsdom": "31.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
